{
  "name": "imeal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.22.0 <25",
    "pnpm": ">=11.17.0 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "eval": "vitest run --config vitest.eval.config.mts",
    "test:watch": "vitest",
    "verify:routes": "node --env-file=.env.local scripts/verify-routes.mjs",
    "verify:rls": "node --env-file=.env.local scripts/verify-rls.mjs",
    "verify:dashboard": "node --env-file=.env.local scripts/verify-dashboard.mjs",
    "verify:planner-view": "node --env-file=.env.local scripts/verify-planner-view.mjs",
    "verify:planning": "node --env-file=.env.local scripts/verify-planning-defaults.mjs",
    "verify:plan-replacement": "node --env-file=.env.local scripts/verify-plan-replacement.mjs",
    "verify:shopping": "node --env-file=.env.local scripts/verify-shopping.mjs",
    "verify:tidy": "node --env-file=.env.local scripts/verify-tidy-apply.mjs",
    "verify:tidy-flow": "node --env-file=.env.local scripts/verify-tidy-flow.mjs",
    "verify:collections": "node --env-file=.env.local scripts/verify-collections.mjs",
    "verify:cooking": "node --env-file=.env.local scripts/verify-cooking.mjs",
    "verify:recipe-copy": "node --env-file=.env.local scripts/verify-recipe-copy.mjs",
    "verify:recipe-menu": "node --env-file=.env.local scripts/verify-recipe-menu.mjs",
    "verify:shared-week": "node --env-file=.env.local scripts/verify-shared-week.mjs",
    "verify:image-removal": "node --env-file=.env.local scripts/verify-image-removal.mjs",
    "verify:moderation": "node --env-file=.env.local scripts/verify-moderation.mjs",
    "verify": "pnpm verify:routes && pnpm verify:rls && pnpm verify:dashboard && pnpm verify:planner-view && pnpm verify:planning && pnpm verify:plan-replacement && pnpm verify:shopping && pnpm verify:tidy && pnpm verify:tidy-flow && pnpm verify:collections && pnpm verify:cooking && pnpm verify:recipe-copy && pnpm verify:recipe-menu && pnpm verify:shared-week && pnpm verify:image-removal && pnpm verify:moderation",
    "seed:catalog": "node --env-file=.env.local scripts/seed-catalog.mjs",
    "security:audit": "pnpm audit --audit-level high",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm security:audit && pnpm build"
  },
  "dependencies": {
    "@heroui/react": "^3.2.2",
    "@heroui/styles": "^3.2.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
