# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses Row Level Security, so it must never reach the browser.
SUPABASE_SERVICE_KEY=

# Server-only. Shopping-list organization uses strict structured model output.
OPENAI_API_KEY=
OPENAI_ORGANIZER_MODEL=gpt-5.6-luna
OPENAI_ORGANIZER_REASONING=none
